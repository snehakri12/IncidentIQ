# Copy to .env and fill in what you use. Everything is optional: with no
# credentials IncidentIQ runs fully locally on the synthetic corpus.

# --- OpenAI (LLM analysis + embeddings) ---
OPENAI_API_KEY=
LLM_ENABLED=false
RAG_USE_CHROMADB=false

# --- GitHub evidence (MCP server, or REST with a token) ---
GITHUB_MCP_URL=
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=

# --- Jira incident history (MCP server, or REST with API token) ---
JIRA_MCP_URL=
JIRA_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
